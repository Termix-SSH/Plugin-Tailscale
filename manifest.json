{
  "id": "tailscale",
  "name": "Tailscale",
  "version": "1.2.0",
  "description": "Add tailnet devices as hosts and connect with Tailscale SSH.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Tailscale",
  "docs": "https://docs.termix.site/plugins/tailscale",
  "video": "https://www.youtube.com/watch?v=NfibAkXDvJk",
  "category": "Networking",
  "icon": "Network",
  "features": [
    "Add tailnet devices as hosts in a couple of clicks",
    "Connect with Tailscale SSH, with no credentials stored",
    "Works with Headscale",
    "A Tailscale card in Host Metrics",
    "A dashboard card with your tailnet devices and which are online"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "network:outbound",
    "network:serve",
    "auth:provide",
    "ssh:connect",
    "credentials:use",
    "credentials:read",
    "ui:surface",
    "notify:send",
    "operations:provide"
  ],
  "optionalDependencies": {
    "host-metrics": "^1.0.0"
  },
  "contributes": {
    "panels": [
      {
        "id": "tailscale",
        "titleKey": "nav.tailscale",
        "icon": "Radar"
      }
    ],
    "permissions": [
      {
        "name": "devices.view",
        "titleKey": "permissions.devices.view.title",
        "descriptionKey": "permissions.devices.view.description",
        "defaultRoles": ["admin"]
      }
    ],
    "auth": {
      "sshAuthTypes": ["tailscale"]
    },
    "settings": {
      "admin": [
        {
          "key": "provider",
          "type": "select",
          "labelKey": "settings.provider.label",
          "descriptionKey": "settings.provider.description",
          "default": "tailscale",
          "options": [
            {
              "value": "tailscale",
              "labelKey": "settings.provider.tailscale"
            },
            {
              "value": "headscale",
              "labelKey": "settings.provider.headscale"
            }
          ],
          "group": "settings.group.api"
        },
        {
          "key": "apiKey",
          "type": "secret",
          "labelKey": "settings.apiKey.label",
          "descriptionKey": "settings.apiKey.description",
          "placeholderKey": "settings.apiKey.placeholder",
          "group": "settings.group.api"
        },
        {
          "key": "apiBaseUrl",
          "type": "string",
          "labelKey": "settings.apiBaseUrl.label",
          "descriptionKey": "settings.apiBaseUrl.description",
          "placeholderKey": "settings.apiBaseUrl.placeholder",
          "default": "",
          "group": "settings.group.api"
        },
        {
          "key": "alertOffline",
          "type": "boolean",
          "labelKey": "settings.alertOffline.label",
          "descriptionKey": "settings.alertOffline.description",
          "default": false,
          "group": "settings.group.devices"
        },
        {
          "key": "devices",
          "type": "custom",
          "component": "devices",
          "group": "settings.group.devices"
        }
      ]
    },
    "uses": ["host-metrics.managers", "terminal.overlay"],
    "dashboardCards": [
      {
        "id": "tailscale-devices",
        "titleKey": "card.title",
        "icon": "Radar"
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "tailscale.devices",
          "titleKey": "operations.devices.title",
          "scope": "server",
          "risk": "read",
          "permission": "devices.view",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "tailscale.status",
          "titleKey": "operations.status.title",
          "scope": "host",
          "risk": "read",
          "permission": "devices.view",
          "hostAccess": "connect",
          "surfaces": {
            "assistant": true,
            "mcp": true,
            "palette": false
          }
        },
        {
          "id": "tailscale.up",
          "titleKey": "operations.up.title",
          "icon": "Wifi",
          "scope": "host",
          "risk": "change",
          "permission": "devices.view",
          "hostAccess": "edit",
          "dryRun": "describe",
          "idempotent": true,
          "undo": "tailscale.down",
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        },
        {
          "id": "tailscale.down",
          "titleKey": "operations.down.title",
          "icon": "WifiOff",
          "scope": "host",
          "risk": "destructive",
          "permission": "devices.view",
          "hostAccess": "edit",
          "dryRun": "describe",
          "idempotent": true,
          "undo": "tailscale.up"
        }
      ],
      "resources": [
        {
          "id": "tailscale.device",
          "titleKey": "operations.device.title",
          "icon": "Radar",
          "list": "tailscale.devices",
          "key": "id",
          "name": "name",
          "status": "state",
          "tab": "tailscale",
          "columns": [
            {
              "key": "address",
              "titleKey": "operations.device.address"
            },
            {
              "key": "os",
              "titleKey": "operations.device.os"
            }
          ],
          "filters": ["state"]
        }
      ],
      "signals": [
        {
          "id": "tailscale.connected",
          "titleKey": "operations.status.title",
          "read": "tailscale.status",
          "scope": "host",
          "kind": "status",
          "refreshSec": 300,
          "fix": "tailscale.up"
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
